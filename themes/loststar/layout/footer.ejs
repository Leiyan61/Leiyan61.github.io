<footer id="footer">
    <div id="footer-wrap">
        <div>
            &copy; <%
                var nowYear = date(Date.now(), "YYYY");
                var sinceYear = theme.footer.since || nowYear;
                var span = (String(sinceYear) === String(nowYear)) ? nowYear : (sinceYear + "-" + nowYear);
            %><%= span %>
            <a href="https://github.com/<%- (theme.footer.copyright && theme.footer.copyright.handle) || config.author %>"><%- (theme.footer.copyright && theme.footer.copyright.name) || config.author %></a>
        </div>
        <div>
            Powered by <a href="https://hexo.io">Hexo</a> |
            Theme <a href="https://github.com/thatnghiep-dev/hexo-theme-loststar">LostStar</a>
        </div>
        <% if (theme.footer.ICP.enable) { %>
        <div>
            <% if (theme.footer.ICP.link) { %>
            <a href="<%- url_for(theme.footer.ICP.link) %>"><%= theme.footer.ICP.code %></a>
            <% } else { %>
            <%= theme.footer.ICP.code %>
            <% } %>
        </div>
        <% } %>
    </div>
</footer>
