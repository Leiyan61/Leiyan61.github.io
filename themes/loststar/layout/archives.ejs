<%
    let posts = site.posts;
    posts.data.sort((a, b) => b.date - a.date);
    const getDisplayTitle = (post) => {
        const catName = post.categories && post.categories.data.length > 0 ? post.categories.data[0].name : null;
        return catName === 'Diary' ? date(post.date, 'DD/MM/YYYY') : post.title;
    };
%>
<div id="archives">
    <%- partial("_partial/page-heading") %>
    <% if (theme.search.enable) { %>
    <div id="search-wrap">
        <input
            id="search-bar"
            class="input"
            type="search"
            placeholder="<%- (theme.i18n && theme.i18n.search_placeholder) || 'Search' %>"
            aria-label="<%- (theme.i18n && theme.i18n.search_placeholder) || 'Search' %>"
            v-model="rawSearch"
        />
    </div>
    <p id="search-empty" v-show="searchEmpty">
        <%- (theme.i18n && theme.i18n.search_no_result) || 'No matching posts' %>
    </p>
    <% } %>
    <div id="timeline-wrap" ref="timeline">
        <% posts.reverse().forEach((post, id) => { %>
        <div class="timeline" data-title="<%- getDisplayTitle(post).toLowerCase().replace(/\s+/g, "") %>">
            <div class="timeline-tail"></div>
            <div class="timeline-content">
                <div class="item-time"><%= date(post.date, "YYYY/M/D") %></div>
                <a href="<%- url_for(post.path) %>">
                    <h3><%= getDisplayTitle(post) %></h3>
                </a>
                <div class="info">
                    <% if (post.categories && post.categories.data.length !== 0) { %>
                    <%
                        const catStyle = getTxCategoryStyle(post.categories.data[0].name);
                    %>
                    <span class="category">
                        <a href="<%- url_for(post.categories.data[0].path) %>"<% if (catStyle) { %> style="color:<%- catStyle.text %>"<% } %>>
                            <span class="icon">
                                <i class="fa-solid fa-bookmark fa-fw"></i>
                            </span>
                            <%= post.categories.data[0].name %>
                        </a>
                    </span>
                    <% } %>
                    <%
                        const arcCatName = post.categories && post.categories.data.length > 0 ? post.categories.data[0].name : null;
                    %>
                    <% if (post.tags && post.tags.data.length !== 0) { %>
                    <span class="tags">
                        <span class="icon">
                            <i class="fa-solid fa-tags fa-fw"></i>
                        </span>
                        <% post.tags.data.forEach((tag) => { %>
                        <%
                            const tagStyle = getTxTagStyle(tag.name, arcCatName);
                        %>
                        <span class="tag">
                            <a href="<%- url_for(tag.path) %>"<% if (tagStyle) { %> style="color:<%- tagStyle.text %>"<% } %>>
                                <%= tag.name %>
                            </a>
                        </span>
                        <% }); %>
                    </span>
                    <% } %>
                </div>
            </div>
        </div>
        <% }); %>
    </div>
</div>
